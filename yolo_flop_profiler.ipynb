   "cell_type": "markdown",
   "id": "cell3-header",
   "metadata": {},
   "source": ["## Cell 3 — FLOP Profiler"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "profiler",
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"\n",
    "FLOP Profiler\n",
    "=============\n",
    "Uses `thop` (primary) with `fvcore` as fallback.\n",
    "Reports:\n",
    "  - GFLOPs  (Giga Floating Point Ops, single forward pass)\n",
    "  - GMACs   (Giga Multiply-Accumulate Ops  ≈ GFLOPs / 2)\n",
    "  - Parameters (millions)\n",
    "  - Estimated FP32 VRAM (model weights only, MB)\n",
    "\"\"\"\n",
    "\n",
    "import torch\n",
    "import json\n",
    "from thop import profile, clever_format\n",
    "from tabulate import tabulate\n",
    "\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'🖥️  Device: {device}')\n",
    "\n",
    "# ── Model registry ────────────────────────────────────────────────────────────\n",
    "# (model_name, model_class, default_input_resolution)\n",
    "MODELS = [\n",
    "    ('YOLOv1',       YOLOv1,    448),\n",
    "    ('Fast-YOLO',    FastYOLO,  448),\n",
    "    ('YOLOv2',       DarkNet19, 416),\n",
    "    ('YOLOv3',       DarkNet53, 416),\n",
    "    ('YOLOv4',       YOLOv4,    608),\n",
    "    ('YOLOv5-L',     YOLOv5,    640),\n",
    "    ('YOLOv6-L',     YOLOv6,    640),\n",
    "    ('YOLOv7',       YOLOv7,    640),\n",
    "    ('YOLOv8-L',     YOLOv8,    640),\n",
    "    ('YOLOv9',       YOLOv9,    640),\n",
    "    ('YOLOv10',      YOLOv10,   640),\n",
    "]\n",
    "\n",
    "# ── Run profiling ─────────────────────────────────────────────────────────────\n",
    "results = []\n",
    "\n",
    "for name, ModelClass, res in MODELS:\n",
    "    try:\n",
    "        model = ModelClass().to(device).eval()\n",
    "        dummy = torch.zeros(1, 3, res, res).to(device)\n",
    "\n",
    "        # thop — counts MACs and params\n",
    "        macs, params = profile(model, inputs=(dummy,), verbose=False)\n",
    "        flops = macs * 2  # 1 MAC = 2 FLOPs\n",
    "\n",
    "        gflops = flops / 1e9\n",
    "        gmacs  = macs  / 1e9\n",
    "        mparams = params / 1e6\n",
    "\n",
    "        # Estimate FP32 model-weight memory (params × 4 bytes)\n",
    "        vram_mb = (params * 4) / 1024**2\n",
    "\n",
    "        results.append({\n",
    "            'Model':      name,\n",
    "            'Input (px)': f'{res}×{res}',\n",
    "            'Params (M)': round(mparams, 2),\n",
    "            'GFLOPs':     round(gflops, 2),\n",
    "            'GMACs':      round(gmacs,  2),\n",
    "            'VRAM FP32 (MB)': round(vram_mb, 1),\n",
    "        })\n",
    "        print(f'  ✅ {name:15s} | {gflops:8.2f} GFLOPs | {mparams:7.2f}M params')\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f'  ❌ {name}: {e}')\n",
    "        results.append({\n",
    "            'Model': name, 'Input (px)': f'{res}×{res}',\n",
    "            'Params (M)': 'ERR', 'GFLOPs': 'ERR', 'GMACs': 'ERR', 'VRAM FP32 (MB)': 'ERR'\n",
    "        })\n",
    "\n",
    "# ── Pretty-print table ────────────────────────────────────────────────────────\n",
    "print('\\n')\n",
    "print(tabulate(results, headers='keys', tablefmt='fancy_grid', numalign='right'))\n",
    "\n",
    "print(\"\"\"\n",
    "📌 Notes:\n",
    "  • GFLOPs = Giga Floating-Point Operations (1 forward pass, batch=1)\n",
    "  • GMACs  = Giga Multiply-Accumulate Ops  (≈ GFLOPs / 2)\n",
    "  • VRAM FP32 (MB) = model weights only (activations not included)\n",
    "  • Actual runtime VRAM ≈ 3–5× weight VRAM due to intermediate activations\n",
    "  • FP16 / INT8 inference halves / quarters the VRAM requirement\n",
    "\"\"\")"
   ]
  },
