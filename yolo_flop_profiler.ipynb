   "cell_type": "markdown",
   "id": "cell4-header",
   "metadata": {},
   "source": ["## Cell 4 — Throughput Benchmark (FPS)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "benchmark",
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"\n",
    "Throughput Benchmark\n",
    "====================\n",
    "Measures FPS (frames per second) in inference mode.\n",
    "Runs 50 warm-up iterations + 200 timed iterations.\n",
    "Reports: median latency (ms), FPS\n",
    "\"\"\"\n",
    "\n",
    "import time\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "\n",
    "WARMUP = 30\n",
    "ITERS  = 100\n",
    "\n",
    "bench_results = []\n",
    "\n",
    "for name, ModelClass, res in MODELS:\n",
    "    try:\n",
    "        model = ModelClass().to(device).eval()\n",
    "        dummy = torch.zeros(1, 3, res, res).to(device)\n",
    "\n",
    "        # Warm-up\n",
    "        with torch.no_grad():\n",
    "            for _ in range(WARMUP):\n",
    "                _ = model(dummy)\n",
    "            if device == 'cuda':\n",
    "                torch.cuda.synchronize()\n",
    "\n",
    "        # Timed iterations\n",
    "        latencies = []\n",
    "        with torch.no_grad():\n",
    "            for _ in range(ITERS):\n",
    "                t0 = time.perf_counter()\n",
    "                _ = model(dummy)\n",
    "                if device == 'cuda':\n",
    "                    torch.cuda.synchronize()\n",
    "                latencies.append((time.perf_counter() - t0) * 1000)  # ms\n",
    "\n",
    "        med_ms = float(np.median(latencies))\n",
    "        fps    = 1000.0 / med_ms\n",
    "        bench_results.append({'Model': name, 'Latency (ms)': round(med_ms, 2), 'FPS': round(fps, 1), 'Device': device.upper()})\n",
    "        print(f'  {name:15s} | {med_ms:8.2f} ms | {fps:7.1f} FPS  [{device.upper()}]')\n",
    "\n",
    "        del model\n",
    "        if device == 'cuda': torch.cuda.empty_cache()\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f'  ❌ {name}: {e}')\n",
    "        bench_results.append({'Model': name, 'Latency (ms)': 'ERR', 'FPS': 'ERR', 'Device': device.upper()})\n",
    "\n",
    "print('\\n')\n",
    "print(tabulate(bench_results, headers='keys', tablefmt='fancy_grid', numalign='right'))"
   ]
  },
