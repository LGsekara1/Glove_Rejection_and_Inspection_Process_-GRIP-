   "source": [
    "# ─── Install dependencies ────────────────────────────────────────────────────\n",
    "import subprocess, sys\n",
    "\n",
    "pkgs = [\n",
    "    'torch', 'torchvision',   # core deep-learning framework\n",
    "    'thop',                   # FLOPs / MACs counter (torch-based)\n",
    "    'fvcore',                 # Facebook's profiler (handles complex graphs)\n",
    "    'tabulate',               # pretty-print tables\n",
    "    'pandas',                 # DataFrame export\n",
    "    'matplotlib', 'seaborn',  # visualisation\n",
    "    'tqdm',                   # progress bars\n",
    "]\n",
    "\n",
    "for pkg in pkgs:\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', pkg, '-q'])\n",
    "\n",
    "print('✅ All dependencies installed.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell2-header",
   "metadata": {},
   "source": ["## Cell 2 — YOLO Architecture Definitions"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "architectures",
   "metadata": {},
   "outputs": [],
   "source": [
    "\"\"\"\n",
    "YOLO Architecture Definitions\n",
    "==============================\n",
    "All models are implemented from their original papers.\n",
    "Input resolution follows the paper default (can be overridden in Cell 3).\n",
    "\n",
    "References:\n",
    "  YOLOv1      : Redmon et al. 2016 (arxiv 1506.02640)\n",
    "  Fast-YOLO   : Redmon et al. 2016 — Tiny variant (9 conv layers, 448 input)\n",
    "  YOLOv2/YOLO9000: Redmon & Farhadi 2017 (arxiv 1612.08242)\n",
    "  YOLOv3      : Redmon & Farhadi 2018 (arxiv 1804.02767)\n",
    "  YOLOv4      : Bochkovskiy et al. 2020 (arxiv 2004.10934)\n",
    "  YOLOv5      : Ultralytics (unofficial)\n",
    "  YOLOv6      : Li et al. 2022 (arxiv 2209.02976)\n",
    "  YOLOv7      : Wang et al. 2022 (arxiv 2207.02696)\n",
    "  YOLOv8      : Ultralytics 2023\n",
    "  YOLOv9      : Wang et al. 2024 (arxiv 2402.13616)\n",
    "  YOLOv10     : Wang et al. 2024 (arxiv 2405.14458)\n",
    "\"\"\"\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "# ─── Helpers ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "def conv_bn_act(in_c, out_c, k=3, s=1, p=1, act=nn.LeakyReLU(0.1, inplace=True)):\n",
    "    \"\"\"Conv → BN → Activation block\"\"\"\n",
    "    return nn.Sequential(\n",
    "        nn.Conv2d(in_c, out_c, k, s, p, bias=False),\n",
    "        nn.BatchNorm2d(out_c),\n",
    "        act if act else nn.Identity()\n",
    "    )\n",
    "\n",
    "def conv_act(in_c, out_c, k=3, s=1, p=1):\n",
    "    \"\"\"Conv → Activation (no BN — original YOLOv1 style)\"\"\"\n",
    "    return nn.Sequential(\n",
    "        nn.Conv2d(in_c, out_c, k, s, p, bias=True),\n",
    "        nn.LeakyReLU(0.1, inplace=True)\n",
    "    )\n",
    "\n",
    "\n",
    "# ─── YOLOv1 ──────────────────────────────────────────────────────────────────\n",
    "class YOLOv1(nn.Module):\n",
    "    \"\"\"\n",
    "    Original YOLO (2016) — GoogLeNet-inspired backbone, 24 conv layers.\n",
    "    Input  : 448 × 448\n",
    "    Output : S×S×(B*5+C) = 7×7×30 for VOC\n",
    "    \"\"\"\n",
    "    def __init__(self, S=7, B=2, C=20):\n",
    "        super().__init__()\n",
    "        self.backbone = nn.Sequential(\n",
    "            # Block 1\n",
    "            conv_act(3,   64,  7, 2, 3),  nn.MaxPool2d(2, 2),\n",
    "            # Block 2\n",
    "            conv_act(64,  192, 3, 1, 1),  nn.MaxPool2d(2, 2),\n",
    "            # Block 3\n",
    "            conv_act(192, 128, 1, 1, 0),\n",
    "            conv_act(128, 256, 3, 1, 1),\n",
    "            conv_act(256, 256, 1, 1, 0),\n",
    "            conv_act(256, 512, 3, 1, 1),  nn.MaxPool2d(2, 2),\n",
    "            # Block 4 (×4 repeated)\n",
    "            conv_act(512, 256, 1, 1, 0), conv_act(256, 512, 3, 1, 1),\n",
    "            conv_act(512, 256, 1, 1, 0), conv_act(256, 512, 3, 1, 1),\n",
    "            conv_act(512, 256, 1, 1, 0), conv_act(256, 512, 3, 1, 1),\n",
    "            conv_act(512, 256, 1, 1, 0), conv_act(256, 512, 3, 1, 1),\n",
    "            conv_act(512, 512, 1, 1, 0), conv_act(512, 1024, 3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            # Block 5 (×2 repeated)\n",
    "            conv_act(1024, 512,  1, 1, 0), conv_act(512,  1024, 3, 1, 1),\n",
    "            conv_act(1024, 512,  1, 1, 0), conv_act(512,  1024, 3, 1, 1),\n",
    "            conv_act(1024, 1024, 3, 1, 1),\n",
    "            conv_act(1024, 1024, 3, 2, 1),\n",
    "            # Block 6\n",
    "            conv_act(1024, 1024, 3, 1, 1),\n",
    "            conv_act(1024, 1024, 3, 1, 1),\n",
    "        )\n",
    "        self.head = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(1024 * S * S, 4096),\n",
    "            nn.LeakyReLU(0.1, inplace=True),\n",
    "            nn.Dropout(0.5),\n",
    "            nn.Linear(4096, S * S * (B * 5 + C))\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "# ─── Fast-YOLO ───────────────────────────────────────────────────────────────\n",
    "class FastYOLO(nn.Module):\n",
    "    \"\"\"\n",
    "    Fast YOLO (2016) — Tiny YOLO, 9 conv layers.\n",
    "    Input  : 448 × 448\n",
    "    Designed for speed over accuracy.\n",
    "    \"\"\"\n",
    "    def __init__(self, S=7, B=2, C=20):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            conv_act(3,   16,  3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(16,  32,  3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(32,  64,  3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(64,  128, 3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(128, 256, 3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(256, 512, 3, 1, 1), nn.MaxPool2d(2, 2),\n",
    "            conv_act(512, 1024, 3, 1, 1),\n",
    "            conv_act(1024, 1024, 3, 1, 1),\n",
    "            conv_act(1024, 1024, 3, 1, 1),\n",
    "        )\n",
    "        self.head = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(1024 * S * S, S * S * (B * 5 + C))\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(self.net(x))\n",
    "\n",
    "\n",
    "# ─── YOLOv2 ──────────────────────────────────────────────────────────────────\n",
    "class DarkNet19(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv2 / YOLO9000 (2017) — Darknet-19 backbone.\n",
    "    Input  : 416 × 416  (or 608 for best mAP)\n",
    "    Key innovation: Batch Norm on all layers, anchor boxes.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80, num_anchors=5):\n",
    "        super().__init__()\n",
    "        lrelu = nn.LeakyReLU(0.1, inplace=True)\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,   32,  3, 1, 1, lrelu), nn.MaxPool2d(2, 2),\n",
    "            conv_bn_act(32,  64,  3, 1, 1, lrelu), nn.MaxPool2d(2, 2),\n",
    "            conv_bn_act(64,  128, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(128, 64,  1, 1, 0, lrelu),\n",
    "            conv_bn_act(64,  128, 3, 1, 1, lrelu), nn.MaxPool2d(2, 2),\n",
    "            conv_bn_act(128, 256, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(256, 128, 1, 1, 0, lrelu),\n",
    "            conv_bn_act(128, 256, 3, 1, 1, lrelu), nn.MaxPool2d(2, 2),\n",
    "            conv_bn_act(256, 512, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(512, 256, 1, 1, 0, lrelu),\n",
    "            conv_bn_act(256, 512, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(512, 256, 1, 1, 0, lrelu),\n",
    "            conv_bn_act(256, 512, 3, 1, 1, lrelu), nn.MaxPool2d(2, 2),\n",
    "            conv_bn_act(512, 1024, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(1024, 512, 1, 1, 0, lrelu),\n",
    "            conv_bn_act(512, 1024, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(1024, 512, 1, 1, 0, lrelu),\n",
    "            conv_bn_act(512, 1024, 3, 1, 1, lrelu),\n",
    "        )\n",
    "        self.head = nn.Sequential(\n",
    "            conv_bn_act(1024, 1024, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(1024, 1024, 3, 1, 1, lrelu),\n",
    "            nn.Conv2d(1024, num_anchors * (5 + num_classes), 1)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "# ─── YOLOv3 ──────────────────────────────────────────────────────────────────\n",
    "class ResidualBlock(nn.Module):\n",
    "    def __init__(self, c):\n",
    "        super().__init__()\n",
    "        self.block = nn.Sequential(\n",
    "            conv_bn_act(c, c // 2, 1, 1, 0),\n",
    "            conv_bn_act(c // 2, c, 3, 1, 1)\n",
    "        )\n",
    "    def forward(self, x): return x + self.block(x)\n",
    "\n",
    "class DarkNet53(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv3 (2018) — Darknet-53 backbone + FPN-style multi-scale heads.\n",
    "    Input  : 416 × 416  (608 for best mAP)\n",
    "    Key innovations: Residual connections, 3-scale detection.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80, num_anchors=3):\n",
    "        super().__init__()\n",
    "        lrelu = nn.LeakyReLU(0.1, inplace=True)\n",
    "        out_c = num_anchors * (5 + num_classes)\n",
    "\n",
    "        self.stem = nn.Sequential(\n",
    "            conv_bn_act(3, 32, 3, 1, 1, lrelu),\n",
    "            conv_bn_act(32, 64, 3, 2, 1, lrelu),\n",
    "            ResidualBlock(64),\n",
    "            conv_bn_act(64, 128, 3, 2, 1, lrelu),\n",
    "            *[ResidualBlock(128) for _ in range(2)],\n",
    "            conv_bn_act(128, 256, 3, 2, 1, lrelu),\n",
    "            *[ResidualBlock(256) for _ in range(8)],\n",
    "        )\n",
    "        self.stage2 = nn.Sequential(\n",
    "            conv_bn_act(256, 512, 3, 2, 1, lrelu),\n",
    "            *[ResidualBlock(512) for _ in range(8)],\n",
    "        )\n",
    "        self.stage3 = nn.Sequential(\n",
    "            conv_bn_act(512, 1024, 3, 2, 1, lrelu),\n",
    "            *[ResidualBlock(1024) for _ in range(4)],\n",
    "        )\n",
    "        # Detection heads (simplified — no skip connections for profiling)\n",
    "        def det_head(in_c, mid_c):\n",
    "            return nn.Sequential(\n",
    "                conv_bn_act(in_c, mid_c, 1, 1, 0, lrelu),\n",
    "                conv_bn_act(mid_c, mid_c * 2, 3, 1, 1, lrelu),\n",
    "                conv_bn_act(mid_c * 2, mid_c, 1, 1, 0, lrelu),\n",
    "                conv_bn_act(mid_c, mid_c * 2, 3, 1, 1, lrelu),\n",
    "                conv_bn_act(mid_c * 2, mid_c, 1, 1, 0, lrelu),\n",
    "                conv_bn_act(mid_c, mid_c * 2, 3, 1, 1, lrelu),\n",
    "                nn.Conv2d(mid_c * 2, out_c, 1)\n",
    "            )\n",
    "        self.head_large  = det_head(1024, 512)\n",
    "        self.head_medium = det_head(512,  256)\n",
    "        self.head_small  = det_head(256,  128)\n",
    "\n",
    "    def forward(self, x):\n",
    "        s1 = self.stem(x)\n",
    "        s2 = self.stage2(s1)\n",
    "        s3 = self.stage3(s2)\n",
    "        out_l = self.head_large(s3)\n",
    "        out_m = self.head_medium(s2)\n",
    "        out_s = self.head_small(s1)\n",
    "        return out_l, out_m, out_s\n",
    "\n",
    "\n",
    "# ─── YOLOv4 ──────────────────────────────────────────────────────────────────\n",
    "class CSPBlock(nn.Module):\n",
    "    \"\"\"Cross Stage Partial block used in YOLOv4 / CSPDarknet-53.\"\"\"\n",
    "    def __init__(self, c, n=1):\n",
    "        super().__init__()\n",
    "        half = c // 2\n",
    "        self.downsample  = conv_bn_act(c, c, 3, 2, 1)\n",
    "        self.split_left  = conv_bn_act(c, half, 1, 1, 0)\n",
    "        self.split_right = conv_bn_act(c, half, 1, 1, 0)\n",
    "        self.blocks = nn.Sequential(*[ResidualBlock(half) for _ in range(n)])\n",
    "        self.merge  = conv_bn_act(half, half, 1, 1, 0)\n",
    "        self.fuse   = conv_bn_act(c, c, 1, 1, 0)\n",
    "    def forward(self, x):\n",
    "        x = self.downsample(x)\n",
    "        l = self.split_left(x)\n",
    "        r = self.merge(self.blocks(self.split_right(x)))\n",
    "        return self.fuse(torch.cat([r, l], 1))\n",
    "\n",
    "class YOLOv4(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv4 (2020) — CSPDarknet-53 + PANet + SAM + BoF/BoS tricks.\n",
    "    Input  : 608 × 608  (best mAP) or 416 × 416\n",
    "    Key innovations: CSP connections, PANet neck, Mish activation.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80, num_anchors=3):\n",
    "        super().__init__()\n",
    "        out_c = num_anchors * (5 + num_classes)\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,  32,  3, 1, 1),\n",
    "            CSPBlock(32,  1),\n",
    "            CSPBlock(64,  2),\n",
    "            CSPBlock(128, 8),\n",
    "            CSPBlock(256, 8),\n",
    "            CSPBlock(512, 4),\n",
    "        )\n",
    "        # SPP block\n",
    "        self.spp = nn.Sequential(\n",
    "            conv_bn_act(1024, 512, 1, 1, 0),\n",
    "            conv_bn_act(512, 1024, 3, 1, 1),\n",
    "            conv_bn_act(1024, 512, 1, 1, 0),\n",
    "        )\n",
    "        # Detection heads\n",
    "        self.head = nn.Sequential(\n",
    "            conv_bn_act(512, 1024, 3, 1, 1),\n",
    "            nn.Conv2d(1024, out_c, 1)\n",
    "        )\n",
    "    def forward(self, x):\n",
    "        f = self.backbone(x)\n",
    "        s = self.spp(f)\n",
    "        return self.head(s)\n",
    "\n",
    "\n",
    "# ─── YOLOv5 ──────────────────────────────────────────────────────────────────\n",
    "class C3Block(nn.Module):\n",
    "    \"\"\"C3 bottleneck block — YOLOv5's CSP variant.\"\"\"\n",
    "    def __init__(self, in_c, out_c, n=1, shortcut=True):\n",
    "        super().__init__()\n",
    "        half = out_c // 2\n",
    "        self.cv1 = conv_bn_act(in_c, half, 1, 1, 0, nn.SiLU())\n",
    "        self.cv2 = conv_bn_act(in_c, half, 1, 1, 0, nn.SiLU())\n",
    "        self.cv3 = conv_bn_act(half * 2, out_c, 1, 1, 0, nn.SiLU())\n",
    "        self.m   = nn.Sequential(*[\n",
    "            nn.Sequential(\n",
    "                conv_bn_act(half, half, 1, 1, 0, nn.SiLU()),\n",
    "                conv_bn_act(half, half, 3, 1, 1, nn.SiLU())\n",
    "            ) for _ in range(n)\n",
    "        ])\n",
    "    def forward(self, x):\n",
    "        return self.cv3(torch.cat([self.m(self.cv1(x)), self.cv2(x)], 1))\n",
    "\n",
    "class YOLOv5(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv5 (Ultralytics, 2020) — CSP backbone + PANet FPN, SiLU activations.\n",
    "    This implements YOLOv5-L (large) depth_mult=1.0, width_mult=1.0.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80, num_anchors=3):\n",
    "        super().__init__()\n",
    "        silu = nn.SiLU()\n",
    "        out_c = num_anchors * (5 + num_classes)\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,   64,  6, 2, 2, silu),\n",
    "            conv_bn_act(64,  128, 3, 2, 1, silu),\n",
    "            C3Block(128, 128, n=3),\n",
    "            conv_bn_act(128, 256, 3, 2, 1, silu),\n",
    "            C3Block(256, 256, n=6),\n",
    "            conv_bn_act(256, 512, 3, 2, 1, silu),\n",
    "            C3Block(512, 512, n=9),\n",
    "            conv_bn_act(512, 1024, 3, 2, 1, silu),\n",
    "            C3Block(1024, 1024, n=3),\n",
    "        )\n",
    "        self.head = nn.Conv2d(1024, out_c, 1)\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "# ─── YOLOv6 ──────────────────────────────────────────────────────────────────\n",
    "class RepVGGBlock(nn.Module):\n",
    "    \"\"\"RepVGG-style reparameterisable block (inference mode = single 3×3 conv).\"\"\"\n",
    "    def __init__(self, in_c, out_c, s=1):\n",
    "        super().__init__()\n",
    "        self.conv = conv_bn_act(in_c, out_c, 3, s, 1, nn.ReLU(inplace=True))\n",
    "        # 1×1 branch (omitted in inference — kept for parameter counting)\n",
    "        self.skip = conv_bn_act(in_c, out_c, 1, s, 0, nn.Identity()) if in_c == out_c else None\n",
    "    def forward(self, x):\n",
    "        out = self.conv(x)\n",
    "        if self.skip is not None: out = out + self.skip(x)\n",
    "        return nn.functional.relu(out, inplace=True)\n",
    "\n",
    "class YOLOv6(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv6-L (Meituan, 2022) — EfficientRep backbone + Rep-PAN neck.\n",
    "    Key innovations: RepVGG blocks, TAL training, decoupled head.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80):\n",
    "        super().__init__()\n",
    "        self.backbone = nn.Sequential(\n",
    "            RepVGGBlock(3,   64,  s=2),\n",
    "            RepVGGBlock(64,  128, s=2), RepVGGBlock(128, 128),\n",
    "            RepVGGBlock(128, 256, s=2), RepVGGBlock(256, 256), RepVGGBlock(256, 256),\n",
    "            RepVGGBlock(256, 512, s=2), *[RepVGGBlock(512, 512) for _ in range(8)],\n",
    "            RepVGGBlock(512, 1024, s=2), RepVGGBlock(1024, 1024),\n",
    "        )\n",
    "        self.head = nn.Conv2d(1024, num_classes + 4, 1)  # anchor-free\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "# ─── YOLOv7 ──────────────────────────────────────────────────────────────────\n",
    "class ELANBlock(nn.Module):\n",
    "    \"\"\"Efficient Layer Aggregation Network block — YOLOv7.\"\"\"\n",
    "    def __init__(self, in_c, out_c, med_c, n=4):\n",
    "        super().__init__()\n",
    "        self.split = nn.ModuleList([\n",
    "            conv_bn_act(in_c if i == 0 else med_c, med_c, 3 if i > 0 else 1, 1, 1 if i > 0 else 0)\n",
    "            for i in range(n)\n",
    "        ])\n",
    "        self.fuse = conv_bn_act(med_c * n, out_c, 1, 1, 0)\n",
    "    def forward(self, x):\n",
    "        outs = []\n",
    "        for i, layer in enumerate(self.split):\n",
    "            x = layer(x if i == 0 else outs[-1])\n",
    "            outs.append(x)\n",
    "        return self.fuse(torch.cat(outs, 1))\n",
    "\n",
    "class YOLOv7(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv7 (Wang et al., 2022) — E-ELAN backbone.\n",
    "    Key innovations: Extended ELAN, Aux heads, RepConv.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80, num_anchors=3):\n",
    "        super().__init__()\n",
    "        out_c = num_anchors * (5 + num_classes)\n",
    "        self.stem = nn.Sequential(\n",
    "            conv_bn_act(3,  32,  3, 1, 1),\n",
    "            conv_bn_act(32, 64,  3, 2, 1),\n",
    "            conv_bn_act(64, 64,  3, 1, 1),\n",
    "        )\n",
    "        self.stage1 = nn.Sequential(conv_bn_act(64, 128, 3, 2, 1),  ELANBlock(128, 256, 64))\n",
    "        self.stage2 = nn.Sequential(conv_bn_act(256, 256, 3, 2, 1), ELANBlock(256, 512, 128))\n",
    "        self.stage3 = nn.Sequential(conv_bn_act(512, 512, 3, 2, 1), ELANBlock(512, 1024, 256))\n",
    "        self.head   = nn.Conv2d(1024, out_c, 1)\n",
    "    def forward(self, x):\n",
    "        x = self.stem(x)\n",
    "        x = self.stage1(x)\n",
    "        x = self.stage2(x)\n",
    "        x = self.stage3(x)\n",
    "        return self.head(x)\n",
    "\n",
    "\n",
    "# ─── YOLOv8 ──────────────────────────────────────────────────────────────────\n",
    "class C2fBlock(nn.Module):\n",
    "    \"\"\"C2f block — YOLOv8's improved bottleneck.\"\"\"\n",
    "    def __init__(self, in_c, out_c, n=1):\n",
    "        super().__init__()\n",
    "        half = out_c // 2\n",
    "        self.cv1 = conv_bn_act(in_c, out_c, 1, 1, 0, nn.SiLU())\n",
    "        self.cv2 = conv_bn_act(out_c + n * half, out_c, 1, 1, 0, nn.SiLU())\n",
    "        self.m   = nn.ModuleList([\n",
    "            nn.Sequential(\n",
    "                conv_bn_act(half, half, 3, 1, 1, nn.SiLU()),\n",
    "                conv_bn_act(half, half, 3, 1, 1, nn.SiLU())\n",
    "            ) for _ in range(n)\n",
    "        ])\n",
    "    def forward(self, x):\n",
    "        y = list(self.cv1(x).chunk(2, 1))\n",
    "        y.extend(m(y[-1]) for m in self.m)\n",
    "        return self.cv2(torch.cat(y, 1))\n",
    "\n",
    "class YOLOv8(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv8-L (Ultralytics, 2023) — CSP backbone + C2f blocks + decoupled head.\n",
    "    Key innovations: Anchor-free, C2f blocks, improved neck.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80):\n",
    "        super().__init__()\n",
    "        silu = nn.SiLU()\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,   64,  3, 2, 1, silu),\n",
    "            conv_bn_act(64,  128, 3, 2, 1, silu),\n",
    "            C2fBlock(128, 128, n=3),\n",
    "            conv_bn_act(128, 256, 3, 2, 1, silu),\n",
    "            C2fBlock(256, 256, n=6),\n",
    "            conv_bn_act(256, 512, 3, 2, 1, silu),\n",
    "            C2fBlock(512, 512, n=6),\n",
    "            conv_bn_act(512, 1024, 3, 2, 1, silu),\n",
    "            C2fBlock(1024, 1024, n=3),\n",
    "        )\n",
    "        # Decoupled detection head\n",
    "        self.cls_head = nn.Conv2d(1024, num_classes, 1)\n",
    "        self.reg_head = nn.Conv2d(1024, 4, 1)\n",
    "    def forward(self, x):\n",
    "        f = self.backbone(x)\n",
    "        return self.cls_head(f), self.reg_head(f)\n",
    "\n",
    "\n",
    "# ─── YOLOv9 ──────────────────────────────────────────────────────────────────\n",
    "class PGIBlock(nn.Module):\n",
    "    \"\"\"Programmable Gradient Information block (simplified) — YOLOv9.\"\"\"\n",
    "    def __init__(self, c, n=4):\n",
    "        super().__init__()\n",
    "        self.layers = nn.Sequential(\n",
    "            *[conv_bn_act(c, c, 3, 1, 1, nn.SiLU()) for _ in range(n)]\n",
    "        )\n",
    "        self.fuse = conv_bn_act(c * (n + 1), c, 1, 1, 0, nn.SiLU())\n",
    "        self.n = n\n",
    "    def forward(self, x):\n",
    "        outs = [x]\n",
    "        for layer in self.layers:\n",
    "            outs.append(layer(outs[-1]))\n",
    "        return self.fuse(torch.cat(outs, 1))\n",
    "\n",
    "class YOLOv9(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv9 (Wang et al., 2024) — GELAN + PGI (Programmable Gradient Info).\n",
    "    Key innovations: PGI for auxiliary reversible branches, GELAN.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80):\n",
    "        super().__init__()\n",
    "        silu = nn.SiLU()\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,   64,  3, 2, 1, silu),\n",
    "            conv_bn_act(64,  128, 3, 2, 1, silu),\n",
    "            PGIBlock(128, n=3),\n",
    "            conv_bn_act(128, 256, 3, 2, 1, silu),\n",
    "            PGIBlock(256, n=6),\n",
    "            conv_bn_act(256, 512, 3, 2, 1, silu),\n",
    "            PGIBlock(512, n=6),\n",
    "            conv_bn_act(512, 1024, 3, 2, 1, silu),\n",
    "            PGIBlock(1024, n=3),\n",
    "        )\n",
    "        self.head = nn.Conv2d(1024, num_classes + 4, 1)\n",
    "    def forward(self, x):\n",
    "        return self.head(self.backbone(x))\n",
    "\n",
    "\n",
    "# ─── YOLOv10 ─────────────────────────────────────────────────────────────────\n",
    "class DualHeadBlock(nn.Module):\n",
    "    \"\"\"NMS-free dual-label assignment block — YOLOv10.\"\"\"\n",
    "    def __init__(self, in_c, num_classes):\n",
    "        super().__init__()\n",
    "        self.one2one = nn.Conv2d(in_c, num_classes + 4, 1)\n",
    "        self.one2many = nn.Conv2d(in_c, num_classes + 4, 1)\n",
    "    def forward(self, x):\n",
    "        return self.one2one(x), self.one2many(x)\n",
    "\n",
    "class YOLOv10(nn.Module):\n",
    "    \"\"\"\n",
    "    YOLOv10 (Wang et al., 2024) — NMS-free dual-assignment detection.\n",
    "    Key innovations: One-to-one + one-to-many heads (eliminates NMS),\n",
    "                     compact inverted block, large-kernel depthwise conv.\n",
    "    Input  : 640 × 640\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=80):\n",
    "        super().__init__()\n",
    "        silu = nn.SiLU()\n",
    "        # Compact Inverted Block\n",
    "        def cib(in_c, out_c):\n",
    "            mid = out_c * 2\n",
    "            return nn.Sequential(\n",
    "                conv_bn_act(in_c, mid, 3, 1, 1, silu),\n",
    "                nn.Conv2d(mid, mid, 7, 1, 3, groups=mid, bias=False),  # depthwise large-kernel\n",
    "                nn.BatchNorm2d(mid),\n",
    "                silu,\n",
    "                conv_bn_act(mid, out_c, 1, 1, 0, silu),\n",
    "            )\n",
    "        self.backbone = nn.Sequential(\n",
    "            conv_bn_act(3,   64,  3, 2, 1, silu),\n",
    "            conv_bn_act(64,  128, 3, 2, 1, silu),\n",
    "            cib(128, 128),\n",
    "            conv_bn_act(128, 256, 3, 2, 1, silu),\n",
    "            cib(256, 256), cib(256, 256),\n",
    "            conv_bn_act(256, 512, 3, 2, 1, silu),\n",
    "            cib(512, 512), cib(512, 512), cib(512, 512),\n",
    "            conv_bn_act(512, 1024, 3, 2, 1, silu),\n",
    "            cib(1024, 1024),\n",
    "        )\n",
    "        self.head = DualHeadBlock(1024, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        f = self.backbone(x)\n",
    "        return self.head(f)\n",
    "\n",
    "\n",
    "print('✅ All YOLO architectures defined (v1, Fast-YOLO, v2–v10).')"
   ]
  },
